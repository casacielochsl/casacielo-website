# Postgres connection string (Vercel Postgres / Neon). Either name works — code checks both.
DATABASE_URL=
POSTGRES_URL=

# Random secret used to sign login session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# SMTP credentials used to send admin "forgot password" reset links.
# For Outlook/Office365: host smtp.office365.com, port 587, SMTP_SECURE=false (STARTTLS).
# SMTP_USER/SMTP_PASS is the sending mailbox — an app password if the account has MFA enabled.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
